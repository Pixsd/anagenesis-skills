{
  "name": "anagenesis-skills",
  "version": "0.1.0",
  "description": "Local, evidence-gated skill revisions for agent CLIs",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "dist",
    "SKILL_PACKAGE_CONTRACT.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "format": "prettier --write src THIRD_PARTY_NOTICES.md package.json tsconfig.json",
    "format:check": "prettier --check src THIRD_PARTY_NOTICES.md package.json tsconfig.json",
    "check": "npm run format:check && npm run build"
  },
  "dependencies": {
    "fs-ext": "2.1.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/fs-ext": "2.0.3",
    "@types/node": "^22.0.0",
    "prettier": "3.8.1",
    "typescript": "^5.9.0"
  },
  "private": true
}
